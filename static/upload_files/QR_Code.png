<!DOCTYPE html>
<html lang="en">

<head><script type="text/javascript" src="/___vscode_livepreview_injected_script"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code Generator</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <div class="box">
        <!-- N.B - .qr-header+.qr-body+.qr-footer wil create three siblings at once -->
        <div class="qr-header">
            <h1>Generate QR Code</h1>
            <input type="text" placeholder="Enter your text or URL" id="qr-text">
            
            <div>
                <!-- set id and for same, e.g. id="sizes  for="sizes-->
                <label for="sizes">Select Size : </label>
                <select id="sizes">
                    <option value="100">100 x 100</option>
                    <option value="200">200 x 200</option>
                    <option value="300">300 x 300</option>
                    <option value="400">400 x 400</option>
                    <option value="500">500 x 500</option>
                    <option value="600">600 x 600</option>
                    <option value="700">700 x 700</option>
                    <option value="800">800 x 800</option>
                    <option value="900">900 x 900</option>
                    <option value="1000">1000 x 1000</option>
                </select>
            </div>
        
        </div>

        <div class="qr-body">

        </div>

        <div class="qr-footer">
            <a href="" id="generateBtn">Generate</a>
            <a href="" id="downloadBtn" download="QR_Code.png">Download</a>
        </div>




    </div>
    <!-- script for generating QR Code -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="script.js"></script>
</body>

</html>